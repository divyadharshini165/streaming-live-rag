# Leave LLM_API_KEY empty to run fully offline (rule-based decomposition + extractive answers).
# Any OpenAI-compatible endpoint works. Groq (free tier) example:
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# Gemini example:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# Local Ollama example:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# Cost estimation: set to your provider's price per million tokens (USD)
PRICE_IN_PER_M_USD=0.05
PRICE_OUT_PER_M_USD=0.08

RETRIEVAL_MODE=hybrid          # hybrid | sparse | dense
DECOMPOSER_MODE=rule           # rule | llm
CORPUS_DIR=data/corpus
TOP_K=5
WORDS_PER_SECOND=2.8           # simulated speaking rate
WORDS_PER_CHUNK=4              # words per streamed transcript chunk
